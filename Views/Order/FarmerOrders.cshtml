@model List<AgriDirect.Models.Order>
@{
    ViewData["Title"] = "Farm Orders";
}

<div style="margin-bottom: 10px;">
    <a asp-controller="Account" asp-action="FarmerDashboard">&larr; Back to Dashboard</a>
</div>

<h1>Farm Orders &amp; Fulfillment</h1>

<div class="box">
    <div class="box-header" style="display: flex; justify-content: space-between; align-items: center;">
        <span>Customer Orders for Your Harvest (@Model.Count)</span>
        <a asp-controller="Product" asp-action="MyProducts" class="btn btn-sm">Manage Products</a>
    </div>

    @if (!Model.Any())
    {
        <p style="color: #666; padding: 10px 0;">You have not received any orders yet. Ensure your harvest listings are active and stocked in the marketplace.</p>
        <a asp-controller="Product" asp-action="Create" class="btn btn-primary">+ Add New Produce</a>
    }
    else
    {
        <table class="simple-table">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Date</th>
                    <th>Product</th>
                    <th>Buyer</th>
                    <th>Quantity</th>
                    <th>Total (₹)</th>
                    <th>Order Status</th>
                    <th>Payment</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td><strong>@order.OrderNumber</strong></td>
                        <td>@order.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@order.ProductId">
                                @(order.Product?.Name ?? "Product #" + order.ProductId)
                            </a>
                        </td>
                        <td>
                            <strong>@order.Buyer?.FullName</strong><br />
                            <span style="font-size: 11px; color: #555;">@order.Buyer?.PhoneNumber</span>
                        </td>
                        <td>@order.Quantity @(order.Product?.Unit ?? "kg")</td>
                        <td><strong>₹@order.TotalAmount.ToString("0.##")</strong></td>
                        <td>
                            <span class="tag">@order.OrderStatus</span>
                        </td>
                        <td>
                            <span class="tag">@order.PaymentStatus</span>
                        </td>
                        <td>
                            <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-primary">Fulfill / Details</a>
                            @if (order.OrderStatus == "Dispatched" || order.OrderStatus == "Delivered")
                            {
                                <a asp-controller="Order" asp-action="Invoice" asp-route-id="@order.Id" class="btn btn-sm" target="_blank" style="margin-top: 3px; display: inline-block;">Invoice</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
