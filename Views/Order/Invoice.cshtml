@model AgriDirect.Models.Order
@{
    ViewData["Title"] = $"Invoice #{Model.OrderNumber}";
    Layout = "_Layout";
}

<div class="no-print" style="margin-bottom: 15px; display: flex; justify-content: space-between; align-items: center;">
    <div>
        <a asp-controller="Order" asp-action="Details" asp-route-id="@Model.Id" class="btn">&larr; Back to Order Details</a>
    </div>
    <div>
        <button onclick="window.print()" class="btn btn-primary" style="background: #15803d; border-color: #15803d; color: #fff;">
            🖨️ Print / Save as PDF
        </button>
    </div>
</div>

<div class="box invoice-box" style="max-width: 800px; margin: 0 auto; padding: 25px; background: #fff; border: 2px solid #333;">
    <!-- Invoice Header -->
    <div style="display: flex; justify-content: space-between; border-bottom: 2px solid #222; padding-bottom: 15px; margin-bottom: 15px;">
        <div>
            <h1 style="margin: 0; font-size: 26px; color: #166534;">🌾 AnnadataDigital</h1>
            <p style="margin: 3px 0 0 0; font-size: 13px; color: #555;">Direct Farmer-to-Consumer Agricultural Platform</p>
            <p style="margin: 2px 0 0 0; font-size: 12px; color: #777;">Official Tax &amp; Delivery Invoice Bill</p>
        </div>
        <div style="text-align: right;">
            <h2 style="margin: 0; font-size: 20px; color: #222;">INVOICE BILL</h2>
            <p style="margin: 3px 0 0 0; font-size: 14px; font-weight: bold;">#@Model.OrderNumber</p>
            <p style="margin: 2px 0 0 0; font-size: 12px; color: #555;">Generated: @DateTime.UtcNow.ToString("dd MMM yyyy, HH:mm") UTC</p>
        </div>
    </div>

    <!-- Timeline of Important Dates -->
    <div style="background: #f8fafc; border: 1px solid #cbd5e1; padding: 10px 14px; border-radius: 4px; margin-bottom: 20px; font-size: 13px;">
        <div style="font-weight: bold; margin-bottom: 6px; color: #334155;">📅 Order Lifecycle Dates:</div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px;">
            <div>
                <strong>Date of Placed Order:</strong><br />
                <span>@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</span>
            </div>
            <div>
                <strong>Date of Confirmed Order:</strong><br />
                <span>@(Model.ConfirmedAt.HasValue ? Model.ConfirmedAt.Value.ToString("dd MMM yyyy, HH:mm") : "Pending")</span>
            </div>
            <div>
                <strong>Date of Dispatching Order:</strong><br />
                <span>@(Model.DispatchedAt.HasValue ? Model.DispatchedAt.Value.ToString("dd MMM yyyy, HH:mm") : "Not yet dispatched")</span>
            </div>
            <div>
                <strong>Date of Delivery:</strong><br />
                <span>@(Model.DeliveredAt.HasValue ? Model.DeliveredAt.Value.ToString("dd MMM yyyy, HH:mm") : "In transit")</span>
            </div>
        </div>
    </div>

    <!-- Two-column Farmer & Consumer Details -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
        <!-- Farmer Details -->
        <div style="border: 1px solid #ddd; padding: 12px; border-radius: 4px; background: #fafafa;">
            <div style="font-weight: bold; font-size: 14px; border-bottom: 1px solid #ccc; padding-bottom: 4px; margin-bottom: 8px; color: #15803d;">
                🚜 Farmer / Producer Details
            </div>
            <p style="margin: 4px 0;"><strong>Name:</strong> @(Model.Farmer?.FullName ?? "N/A")</p>
            <p style="margin: 4px 0;"><strong>Farm Name:</strong> @(Model.Farmer?.FarmName ?? "Direct Farm")</p>
            <p style="margin: 4px 0;"><strong>Location:</strong> @(Model.Farmer?.FarmLocation ?? Model.Farmer?.Address ?? "N/A")</p>
            <p style="margin: 4px 0;"><strong>Phone:</strong> @(Model.Farmer?.PhoneNumber ?? "N/A")</p>
            <p style="margin: 4px 0;"><strong>UPI ID:</strong> <span style="font-family: monospace; font-weight: bold;">@(Model.Farmer?.UpiId ?? "N/A")</span></p>
        </div>

        <!-- Consumer Details -->
        <div style="border: 1px solid #ddd; padding: 12px; border-radius: 4px; background: #fafafa;">
            <div style="font-weight: bold; font-size: 14px; border-bottom: 1px solid #ccc; padding-bottom: 4px; margin-bottom: 8px; color: #1e40af;">
                🛒 Consumer / Buyer Details
            </div>
            <p style="margin: 4px 0;"><strong>Name:</strong> @(Model.Buyer?.FullName ?? "N/A")</p>
            <p style="margin: 4px 0;"><strong>Phone:</strong> @(Model.Buyer?.PhoneNumber ?? "N/A")</p>
            <p style="margin: 4px 0;"><strong>Delivery Address:</strong> @Model.DeliveryAddress</p>
            <p style="margin: 4px 0;"><strong>Consumer UPI ID:</strong> <span style="font-family: monospace;">@(Model.Buyer?.UpiId ?? "Not provided")</span></p>
        </div>
    </div>

    <!-- Transporter Details Section -->
    <div style="border: 1px solid #f59e0b; background: #fffbeb; padding: 12px; border-radius: 4px; margin-bottom: 20px;">
        <div style="font-weight: bold; font-size: 14px; color: #92400e; margin-bottom: 6px;">
            🚚 Transporter Details (Truck Driver)
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 13px;">
            <div>
                <strong>Driver / Transporter Name:</strong><br />
                <span style="font-size: 14px;">@(string.IsNullOrWhiteSpace(Model.TransporterName) ? "Pending dispatch assignment" : Model.TransporterName)</span>
            </div>
            <div>
                <strong>Driver Contact Number:</strong><br />
                <span style="font-size: 14px; font-weight: bold;">@(string.IsNullOrWhiteSpace(Model.TransporterContact) ? "Pending dispatch assignment" : Model.TransporterContact)</span>
            </div>
        </div>
    </div>

    <!-- Produce / Item Table -->
    <div style="margin-bottom: 20px;">
        <div style="font-weight: bold; font-size: 14px; margin-bottom: 6px;">🌾 Produce &amp; Pricing Details:</div>
        <table class="simple-table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f1f5f9;">
                    <th style="border: 1px solid #cbd5e1; padding: 8px; text-align: left;">Item Description</th>
                    <th style="border: 1px solid #cbd5e1; padding: 8px; text-align: left;">Category</th>
                    <th style="border: 1px solid #cbd5e1; padding: 8px; text-align: right;">Unit Price</th>
                    <th style="border: 1px solid #cbd5e1; padding: 8px; text-align: right;">Quantity</th>
                    <th style="border: 1px solid #cbd5e1; padding: 8px; text-align: right;">Total Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td style="border: 1px solid #cbd5e1; padding: 10px 8px;">
                        <strong>@(Model.Product?.Name ?? "Agricultural Produce")</strong>
                    </td>
                    <td style="border: 1px solid #cbd5e1; padding: 10px 8px;">
                        @(Model.Product?.Category ?? "Produce")
                    </td>
                    <td style="border: 1px solid #cbd5e1; padding: 10px 8px; text-align: right;">
                        ₹@Model.UnitPrice.ToString("0.##") / @Model.Product?.Unit
                    </td>
                    <td style="border: 1px solid #cbd5e1; padding: 10px 8px; text-align: right; font-weight: bold;">
                        @Model.Quantity @Model.Product?.Unit
                    </td>
                    <td style="border: 1px solid #cbd5e1; padding: 10px 8px; text-align: right; font-weight: bold; font-size: 15px;">
                        ₹@Model.TotalAmount.ToString("0.##")
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr style="background: #f8fafc; font-weight: bold;">
                    <td colspan="4" style="border: 1px solid #cbd5e1; padding: 8px; text-align: right;">Subtotal:</td>
                    <td style="border: 1px solid #cbd5e1; padding: 8px; text-align: right;">₹@Model.TotalAmount.ToString("0.##")</td>
                </tr>
                <tr style="background: #f8fafc; font-weight: bold; font-size: 16px;">
                    <td colspan="4" style="border: 1px solid #cbd5e1; padding: 10px 8px; text-align: right; color: #166534;">Grand Total:</td>
                    <td style="border: 1px solid #cbd5e1; padding: 10px 8px; text-align: right; color: #166534;">₹@Model.TotalAmount.ToString("0.##")</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Payment Status Box -->
    <div style="display: flex; justify-content: space-between; align-items: center; background: #f3f4f6; padding: 12px 16px; border-radius: 4px; border: 1px solid #d1d5db; margin-bottom: 20px;">
        <div>
            <p style="margin: 0; font-size: 13px;"><strong>Payment Method:</strong> @Model.PaymentMethod</p>
            <p style="margin: 4px 0 0 0; font-size: 13px;">
                <strong>Payment Status:</strong> 
                <span class="tag" style="font-weight: bold; font-size: 13px; @(Model.PaymentStatus == "Paid" ? "background: #dcfce7; color: #166534;" : "background: #fef3c7; color: #92400e;")">
                    @(Model.PaymentStatus == "Paid" ? "✓ PAID" : "⏳ PENDING")
                </span>
            </p>
            @if (Model.PaymentMethod == "UPI")
            {
                <p style="margin: 4px 0 0 0; font-size: 12px; color: #555;">
                    Paid via UPI to: <strong>@(Model.Farmer?.UpiId ?? "Farmer UPI")</strong>
                </p>
            }
        </div>
        <div>
            <p style="margin: 0; font-size: 13px;"><strong>Order Status:</strong></p>
            <span class="tag" style="font-size: 14px; font-weight: bold;">@Model.OrderStatus</span>
        </div>
    </div>

    <!-- Invoice Footer Notes -->
    <div style="border-top: 1px dashed #aaa; padding-top: 12px; text-align: center; font-size: 11px; color: #666;">
        <p style="margin: 0;">This is a computer-generated tax &amp; delivery invoice from AnnadataDigital Direct Agri-Commerce.</p>
        <p style="margin: 2px 0 0 0;">Thank you for supporting our local farmers directly!</p>
    </div>
</div>

<style>
    @@media print {
        header, nav, footer, .no-print, .btn {
            display: none !important;
        }
        body {
            background: #fff !important;
            color: #000 !important;
            margin: 0 !important;
            padding: 10px !important;
        }
        .invoice-box {
            border: none !important;
            box-shadow: none !important;
            max-width: 100% !important;
            padding: 0 !important;
        }
    }
</style>
