@model AgriDirect.Models.ViewModels.ProductFormViewModel
@{
    ViewData["Title"] = "Edit Produce";
}

<div style="margin-bottom: 10px;">
    <a asp-controller="Product" asp-action="MyProducts">&larr; Back to My Products</a>
</div>

<h1>Edit Produce Listing</h1>

<div style="max-width: 550px; margin-top: 15px;">
    <div class="box">
        <form asp-controller="Product" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ExistingImageUrl" />
            <input type="hidden" asp-for="ExistingAdditionalImageUrls" />
            <div asp-validation-summary="ModelOnly" class="text-error" style="margin-bottom: 10px;"></div>

            <div class="form-group">
                <label asp-for="Name" class="form-label">Product Name:</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Category" class="form-label">Category:</label>
                <select asp-for="Category" class="form-select" id="productCategory" onchange="syncCategoryUnit()">
                    <option value="Vegetables">Vegetables</option>
                    <option value="Grains">Grains</option>
                    <option value="Fruits">Fruits</option>
                    <option value="Dairy">Dairy</option>
                </select>
                <span asp-validation-for="Category" class="text-error"></span>
                <small id="categoryUnitNote" style="color: #1b5e20; font-size: 12px; display: block; margin-top: 4px;">
                    ℹ️ For Vegetables: kg | For Grains: quintal
                </small>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px;">
                <div class="form-group">
                    <label asp-for="Price" class="form-label" id="priceLabel">Price (₹ / @Model.Unit):</label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Price" class="text-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="QuantityInStock" class="form-label" id="stockLabel">Stock Quantity (@Model.Unit):</label>
                    <input asp-for="QuantityInStock" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="QuantityInStock" class="text-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Unit" class="form-label">Unit:</label>
                    <select asp-for="Unit" class="form-select" id="productUnit">
                        <option value="kg">kg</option>
                        <option value="quintal">quintal</option>
                        <option value="dozen">dozen</option>
                        <option value="box">box</option>
                        <option value="liter">liter</option>
                    </select>
                    <span asp-validation-for="Unit" class="text-error"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="HarvestDate" class="form-label">Harvest Date:</label>
                <input asp-for="HarvestDate" class="form-control" type="date" />
                <span asp-validation-for="HarvestDate" class="text-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label">Description:</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-error"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Update Primary Image:</label>
                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
            </div>

            <div class="form-group">
                <label class="form-label">Upload Additional Images (one or more):</label>
                <input asp-for="AdditionalImageFiles" type="file" multiple class="form-control" accept="image/*" />
            </div>

            <div style="margin-top: 15px;">
                <button type="submit" class="btn btn-primary">Update Product</button>
                <a asp-controller="Product" asp-action="MyProducts" class="btn">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function syncCategoryUnit() {
            var cat = document.getElementById('productCategory').value;
            var unitSelect = document.getElementById('productUnit');
            var priceLabel = document.getElementById('priceLabel');
            var stockLabel = document.getElementById('stockLabel');
            var note = document.getElementById('categoryUnitNote');

            if (cat === 'Grains') {
                unitSelect.value = 'quintal';
                priceLabel.innerText = 'Price (₹ / quintal):';
                stockLabel.innerText = 'Stock Quantity (quintals):';
                note.innerHTML = '🌾 For Grains, quantity and price are calculated in <strong>quintals</strong>.';
            } else if (cat === 'Vegetables') {
                unitSelect.value = 'kg';
                priceLabel.innerText = 'Price (₹ / kg):';
                stockLabel.innerText = 'Stock Quantity (kg):';
                note.innerHTML = '🥬 For Vegetables, quantity and price are calculated in <strong>kg</strong>.';
            } else {
                priceLabel.innerText = 'Price (₹ / ' + unitSelect.value + '):';
                stockLabel.innerText = 'Stock Quantity (' + unitSelect.value + '):';
                note.innerHTML = 'ℹ️ Unit for ' + cat + ' is ' + unitSelect.value + '.';
            }
        }
    </script>
}
